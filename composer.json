{
    "name": "pieceofcake2/monolog",
    "description": "CakePHP 2 Monolog Plugin",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "cakephp2", "monolog"],
    "license": "MIT",
    "require": {
        "php": "^8.0",
        "composer/installers": "*",
        "monolog/monolog": "^2.5|^3.9",
        "pieceofcake2/cakephp": "^2.10"
    },
    "require-dev": {
        "cakephp/cakephp-codesniffer": "^5.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^9.6",
        "pieceofcake2/app": "^2.1",
        "pieceofcake2/phpstan-cakephp2": "^0.2.1"
    },
    "replace": {
        "cakephp/monolog": "*",
        "jadb/cakephp-monolog": "*"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "extra": {
        "installer-name": "Monolog"
    }
}
